generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TreeStatus {
  SEED
  SAPLING
  JUVENILE
  GROWN
  DEAD
}

model User {
  userId         String     @id @default(uuid())
  username       String     @unique
  password_hash  String
  display_name   String?
  bio            String?
  avatar_url     String?
  xp             Int        @default(0)
  penalty_points Int        @default(0)
  status         TreeStatus @default(SEED)
  creation_date  DateTime   @default(now())
  
  workouts       Workout[]
}

enum WorkoutStatus {
  IN_PROGRESS
  COMPLETED
}

model Workout {
  workoutId   String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [userId])
  startTime   DateTime      @default(now())
  endTime     DateTime?
  status      WorkoutStatus @default(IN_PROGRESS)
  sets        Set[]
}

model Set {
  setId       String   @id @default(uuid())
  workoutId   String
  workout     Workout  @relation(fields: [workoutId], references: [workoutId])
  exercise    String
  sets        Int      
  reps        Int
  weightKg    Float?
  date        DateTime @default(now())
}